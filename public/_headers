# Security Headers for Cloudflare Workers Assets
# https://developers.cloudflare.com/workers/static-assets/headers/

/*
  # Prevent clickjacking
  X-Frame-Options: DENY

  # Prevent MIME type sniffing
  X-Content-Type-Options: nosniff

  # Declare AI content usage preferences for crawlers that read response headers
  Content-Signal: ai-train=no, search=yes, ai-input=yes

  # Referrer policy
  Referrer-Policy: strict-origin-when-cross-origin

  # Permissions policy - disable unnecessary features
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), payment=(), usb=()

  # Content-Security-Policy は Astro security.csp のページ内 meta（ハッシュ付き）を
  # Worker が HTTP ヘッダへ昇格する。ここに固定の script-src/style-src を重ねると
  # ブラウザは両方を満たす必要があり、ハッシュベース CSP と衝突する。
