# Copy to .dev.vars for wrangler dev. Do not commit the real secret.
CONTENT_HMAC_SECRET=replace-me-with-a-long-random-string
DEPLOY_HOOK_URL=
TURNSTILE_SECRET=1x0000000000000000000000000000000AA
# ローカル検証用。本番 wrangler.jsonc の TURNSTILE_HOSTNAMES には localhost を入れない。
TURNSTILE_HOSTNAMES=localhost,127.0.0.1
SLACK_WEBHOOK_URL=
# 検証済み受信箱。EMAIL_INBOX.send() の to に使う
CONTACT_INBOX_EMAIL=
