---
import type { BlogListItem } from "@/lib/content/blog";
import { formatDate } from "@/utils/date";

interface Props {
	posts: BlogListItem[];
	basePath?: string;
}

const { posts, basePath = "/blog" } = Astro.props;

// 関連記事がない場合は何も表示しない
if (posts.length === 0) {
	return null;
}
---

<aside class="mt-12 pt-8">
  <h2 class="mb-6 text-xl font-bold text-(--text-primary)">関連記事</h2>
  <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      posts.map((post) => (
        <a
          href={`${basePath}/${post.slug}`}
          class="group flex flex-col rounded-lg bg-(--bg-secondary) p-4 transition-colors hover:bg-(--bg-elevated)"
        >
          <span class="mb-2 text-sm text-(--text-muted)">
            {formatDate(post.date)}
          </span>
          <span class="mb-2 font-medium text-(--text-primary) transition-colors group-hover:text-(--primary-color)">
            {post.title}
          </span>
          {post.tags.length > 0 && (
            <div class="mt-auto flex flex-wrap gap-1">
              {post.tags.slice(0, 2).map((tag) => (
                <span class="rounded bg-(--bg-tertiary) px-2 py-0.5 text-xs text-(--text-secondary)">
                  {tag}
                </span>
              ))}
            </div>
          )}
        </a>
      ))
    }
  </div>
</aside>
