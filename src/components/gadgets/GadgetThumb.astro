---
import type { Gadget } from "@/data/gadgets";

interface Props {
	gadget: Gadget;
	size: "grid" | "detail";
}

const { gadget, size } = Astro.props;
---

<img
	src={gadget.image}
	alt=""
	width="400"
	height="400"
	draggable="false"
	decoding="async"
	data-gadget-thumb={gadget.slug}
	class:list={[
		"pointer-events-none select-none object-contain",
		size === "grid" &&
			"h-full max-h-20 w-full max-w-20 lg:max-h-24 lg:max-w-24",
		size === "detail" && "h-full w-full object-contain",
	]}
/>
