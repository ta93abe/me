---
import type { Gadget } from "@/data/gadgets";
import { gadgetImageUrl } from "@/data/gadget-images";

interface Props {
	gadget: Gadget;
	size: "grid" | "detail";
}

const { gadget, size } = Astro.props;
const image = gadgetImageUrl(gadget.slug);
---

<img
	src={image}
	alt=""
	width="800"
	height="800"
	draggable="false"
	decoding="async"
	loading={size === "grid" ? "lazy" : "eager"}
	data-gadget-thumb={gadget.slug}
	class:list={[
		"pointer-events-none select-none object-contain",
		size === "grid" &&
			"h-full max-h-28 w-full max-w-full lg:max-h-32",
		size === "detail" && "h-full w-full object-contain",
	]}
/>
