---
// PostHog analytics。bundled な薄いブートストラップにして Astro CSP ハッシュ対象にする。
// posthog-js / recorder / surveys はアイドルまたは最初の操作まで読み込まない。
const enabled =
	import.meta.env.PROD && Boolean(import.meta.env.PUBLIC_POSTHOG_PROJECT_TOKEN);
---

{
	enabled && (
		<script>
			import "../scripts/posthog";
		</script>
	)
}
