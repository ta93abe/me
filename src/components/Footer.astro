---
import NewsletterCta from "@/components/NewsletterCta.astro";
import { SECONDARY_NAV_LINKS } from "@/config/navigation";

const currentYear = new Date().getFullYear();
---

<footer class="bg-transparent" role="contentinfo">
	<div
		class="mx-auto flex max-w-7xl flex-col gap-4 px-6 py-10 sm:flex-row sm:items-center sm:justify-between"
	>
		<div class="flex flex-col gap-3">
			<NewsletterCta variant="footer" source="footer" />
			<nav aria-label="二次ナビゲーション">
				<ul class="flex flex-wrap items-center gap-x-4 gap-y-2">
					{
						SECONDARY_NAV_LINKS.map((link) => (
							<li>
								<a
									href={link.href}
									class="text-sm text-(--text-muted) transition-colors hover:text-(--text-primary)"
								>
									{link.text}
								</a>
							</li>
						))
					}
				</ul>
			</nav>
		</div>
		<p class="text-sm text-(--text-muted) sm:text-right">
			&copy; {currentYear} ta93abe. All rights reserved.
		</p>
	</div>
</footer>
