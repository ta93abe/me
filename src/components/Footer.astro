---
import NewsletterCta from "@/components/NewsletterCta.astro";
import { SECONDARY_LINKS } from "@/config/navigation";

const currentYear = new Date().getFullYear();
---

<footer class="bg-transparent" role="contentinfo">
	<div
		class="mx-auto flex max-w-7xl flex-wrap items-center justify-between gap-x-6 gap-y-3 px-6 py-10"
	>
		<nav aria-label="二次ナビゲーション">
			<ul class="flex flex-wrap items-center gap-x-4 gap-y-1">
				{
					SECONDARY_LINKS.map((link) => (
						<li>
							<a
								href={link.href}
								class="text-sm text-(--text-muted) transition-colors hover:text-(--text-primary) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--primary-color)"
							>
								{link.text}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<div class="flex flex-wrap items-center gap-x-4 gap-y-1">
			<NewsletterCta variant="footer" source="footer" />
			<p class="text-right text-sm text-(--text-muted)">
				&copy; {currentYear} ta93abe. All rights reserved.
			</p>
		</div>
	</div>
</footer>
