---
import { cachedTweetData } from "@/lib/content/blog-embed-html";
import { tweetEmbedHtml } from "@/lib/content/tweet";
import { parseTweetScale, resolveTweetRef } from "@/lib/content/tweet-ref";

/**
 * X のポストを埋め込む（Slidev の <Tweet> 相当）。ブログとスライドの MDX で使う。
 * ビルド時に本文・著者・画像・引用・日時を取得して静的 HTML にする（widgets.js / iframe / クライアント JS なし）。
 * 取得に失敗したらポストへのリンクカードを出す。
 *
 * ブログだけ `live` を付けると、閲覧時に X の widgets.js を読み、公式の埋め込みに差し替える（opt-in）。
 * 読み込みに失敗したら静的カードのまま。CSP とスクリプトは blog/[id].astro がそのページだけに足す。
 * スライドでは使えない（PDF と CSP を変えないため。remark-slide-guard が live を落とす）。
 *
 * <Tweet id="2098270535855870306" />
 * <Tweet url="https://x.com/civitaspo/status/2098270535855870306" scale="0.8" cards="hidden" />
 * <Tweet id="2098270535855870306" live />
 */
type Props = {
	/** ポストの id。url より優先する */
	id?: string | number;
	/** x.com / twitter.com のポスト URL */
	url?: string;
	/** 表示倍率（0.25〜3） */
	scale?: string | number;
	/** "hidden" で画像・動画・引用ポストを出さない */
	cards?: "visible" | "hidden";
	/** ブログだけ。閲覧時に X の widgets.js で公式の埋め込みにする */
	live?: boolean;
};

const { id, url, scale, cards = "visible", live = false } = Astro.props;
const ref = resolveTweetRef({ id, url });
if (!ref) {
	throw new Error(
		`<Tweet> には id か x.com のポスト URL が必要です（id=${String(id)} url=${String(url)}）`,
	);
}
if (cards !== "visible" && cards !== "hidden") {
	throw new Error(`<Tweet cards> は visible か hidden です: ${String(cards)}`);
}
const zoom = parseTweetScale(scale);
if (Number.isNaN(zoom)) {
	throw new Error(`<Tweet scale> は 0.25〜3 の数です: ${String(scale)}`);
}

const html = tweetEmbedHtml(ref.href, await cachedTweetData(ref.id), {
	media: cards !== "hidden",
});
---

<div
	class="tweet-embed-frame"
	data-tweet-id={ref.id}
	data-tweet-live={live ? "" : undefined}
	data-tweet-cards={live ? cards : undefined}
	style={zoom === undefined ? undefined : `--tweet-scale: ${zoom}`}
>
	<Fragment set:html={html} />
	{live && <div class="tweet-embed-live" />}
</div>
