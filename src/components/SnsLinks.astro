---
import * as simpleIcons from "simple-icons";
import type { SimpleIcon } from "simple-icons";
import { CUSTOM_ICONS } from "@/data/custom-icons";
import linksData from "@/data/links.json";

interface ResolvedIcon {
	path: string;
	hex: string;
	viewBox: string;
	stroke?: {
		color: string;
		width: string;
	};
}

const resolveIcon = (slug: string): ResolvedIcon => {
	const custom = CUSTOM_ICONS[slug];
	if (custom) {
		return {
			path: custom.path,
			hex: custom.hex,
			viewBox: custom.viewBox ?? "0 0 24 24",
			stroke: custom.stroke,
		};
	}

	const key = `si${slug.charAt(0).toUpperCase()}${slug.slice(1)}`;
	const icon = (simpleIcons as unknown as Record<string, SimpleIcon>)[key];
	if (!icon) {
		throw new Error(
			`Unknown icon slug "${slug}". simple-icons のスラッグを指定するか、src/data/custom-icons.ts に追加してください。`,
		);
	}
	return { path: icon.path, hex: `#${icon.hex}`, viewBox: "0 0 24 24" };
};

const links = linksData.links.map((link) => ({
	...link,
	iconData: resolveIcon(link.icon),
}));
---

<ul class="sns-links sns-list">
	{
		links.map((link) => (
			<li>
				<a
					href={link.url}
					target="_blank"
					rel="noopener noreferrer"
					class="sns-row"
					aria-label={link.name}
				>
					<svg
						viewBox={link.iconData.viewBox}
						class="sns-row-icon"
						aria-hidden="true"
					>
						{link.iconData.stroke ? (
							<path
								d={link.iconData.path}
								fill="none"
								stroke={link.iconData.stroke.color}
								stroke-width={link.iconData.stroke.width}
								stroke-linecap="round"
								stroke-linejoin="round"
							/>
						) : (
							<path d={link.iconData.path} fill={link.iconData.hex} />
						)}
					</svg>
					<span class="sns-row-name">{link.name}</span>
					<span class="sns-row-host">{new URL(link.url).host}</span>
				</a>
			</li>
		))
	}
</ul>

<style>
	.sns-list {
		display: flex;
		flex-direction: column;
		margin: 0;
		padding: 0;
		list-style: none;
		border-top: 1px solid var(--border-color);
	}

	.sns-row {
		display: grid;
		grid-template-columns: 1.25rem minmax(0, 8rem) minmax(0, 1fr);
		align-items: center;
		gap: 0.75rem 1rem;
		padding: 0.9rem 0;
		text-decoration: none;
		color: inherit;
		border-bottom: 1px solid var(--border-color);
		transition: color 0.15s ease;
	}

	.sns-row:hover {
		color: var(--primary-color);
	}

	.sns-row-icon {
		width: 1.25rem;
		height: 1.25rem;
		flex-shrink: 0;
	}

	.sns-row-name {
		font-size: 0.9375rem;
		font-weight: 600;
		color: var(--text-primary);
	}

	.sns-row:hover .sns-row-name {
		color: inherit;
	}

	.sns-row-host {
		font-size: 0.8125rem;
		color: var(--text-muted);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
</style>

<script>
	document.querySelectorAll(".sns-links a[href]").forEach((link) => {
		link.addEventListener("click", () => {
			window.posthog?.capture("sns_link_clicked", {
				platform: link.getAttribute("aria-label"),
				url: link.getAttribute("href"),
			});
		});
	});
</script>
