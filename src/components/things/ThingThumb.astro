---
import type { Thing } from "@/data/things";

interface Props {
	thing: Thing;
	size: "grid" | "detail";
}

const { thing, size } = Astro.props;
---

<img
	src={thing.image}
	alt=""
	width="400"
	height="400"
	draggable="false"
	decoding="async"
	data-thing-thumb={thing.slug}
	class:list={[
		"pointer-events-none select-none object-contain",
		size === "grid" &&
			"h-full max-h-20 w-full max-w-20 lg:max-h-24 lg:max-w-24",
		size === "detail" && "h-full w-full object-contain",
	]}
/>
