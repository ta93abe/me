---
import { HOME_CTAS, SITE } from "@/config/site";
---

<section id="hero" class="hero" aria-labelledby="hero-name">
	<div class="hero-copy">
		<h1 id="hero-name" class="hero-name">{SITE.name}</h1>

		<nav class="hero-cta" aria-label="主なページ">
			{
				HOME_CTAS.map((cta) => (
					<a href={cta.href} class="hero-cta-link">
						{cta.label}
					</a>
				))
			}
		</nav>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100%;
		background: var(--bg-primary);
	}

	.hero-copy {
		display: flex;
		flex: 1 0 auto;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		box-sizing: border-box;
		width: 100%;
		padding: calc(var(--header-height) + 1rem) 1.5rem 5.75rem;
		text-align: center;
	}

	.hero-name {
		margin: 0;
		font-size: 1.25rem;
		font-weight: 400;
		letter-spacing: 0.02em;
		line-height: 1.4;
		color: var(--text-primary);
	}

	.hero-cta {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.15rem 1.35rem;
		margin-top: 1rem;
	}

	.hero-cta-link {
		display: inline-flex;
		align-items: center;
		min-height: 2.5rem;
		padding: 0.2rem 0;
		font-size: 0.875rem;
		font-weight: 400;
		text-decoration: none;
		color: var(--text-secondary);
		transition: color 0.15s ease;
	}

	.hero-cta-link:hover,
	.hero-cta-link:focus-visible {
		color: var(--text-primary);
	}

	@media (prefers-reduced-motion: reduce) {
		.hero-cta-link {
			transition: none;
		}
	}
</style>

<script>
	document.querySelectorAll(".hero-cta a[href]").forEach((link) => {
		link.addEventListener("click", () => {
			window.posthog?.capture("home_cta_clicked", {
				label: link.textContent?.trim(),
				href: link.getAttribute("href"),
			});
		});
	});
</script>
