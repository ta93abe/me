---
import PostHog from "@/components/posthog.astro";
import { SITE } from "@/config/site";
import type { Deck } from "@/slides/parser/types";
import { renderSlideSections } from "@/slides/render";
import { generateSlideDeckSchema, stringifySchema } from "@/utils/schema";
import "katex/dist/katex.min.css";
import "@/slides/design-system/tokens.css";
import "@/slides/design-system/typography.css";
import "@/slides/design-system/layouts.css";
import "@/slides/design-system/shiki.css";
import "@/slides/player/player.css";

interface Props {
	deck: Deck;
	print?: boolean;
}

const { deck, print = false } = Astro.props;
const { title, description, slug, theme, date } = deck.frontmatter;
const siteBase = Astro.site?.href || SITE.url;
const playerURL = new URL(`/slides/${slug}/`, siteBase);
const ogImageURL = new URL(`/og/slides/${slug}.png`, siteBase);
const pdfHref = `/slides/${slug}.pdf`;
const pageTitle = `${title} | Slides | ${SITE.name}`;
const robotsContent = print ? "noindex, nofollow" : "index, follow";
const deckSchema = generateSlideDeckSchema(siteBase, {
	slug,
	title,
	description,
	date,
});
const sections = renderSlideSections(deck, { print });
---

<!doctype html>
<html
	lang="ja"
	data-theme={theme}
	data-print-ready={print ? true : undefined}
	class:list={[{ "is-print": print }]}
>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" type="image/png" sizes="48x48" href="/favicon.png" />
		<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{pageTitle}</title>
		<meta name="title" content={pageTitle} />
		<meta name="description" content={description} />
		<meta name="author" content={SITE.author} />
		<meta name="robots" content={robotsContent} />
		<link rel="canonical" href={playerURL} />

		<meta property="og:type" content="website" />
		<meta property="og:url" content={playerURL} />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:alt" content={title} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta property="og:image:type" content="image/png" />
		<meta property="og:site_name" content={SITE.name} />
		<meta property="og:locale" content={SITE.locale} />

		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:site" content={SITE.twitter} />
		<meta name="twitter:creator" content={SITE.twitter} />
		<meta name="twitter:url" content={playerURL} />
		<meta name="twitter:title" content={pageTitle} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={title} />

		{
			!print && (
				<link rel="alternate" type="application/pdf" href={pdfHref} />
			)
		}
		{
			!print && (
				<script
					type="application/ld+json"
					set:html={stringifySchema(deckSchema)}
				/>
			)
		}
		<PostHog />
	</head>
	<body>
		<div class="stage-wrap">
			<article
				class="deck"
				data-slug={slug}
				data-length={deck.slides.length}
				set:html={sections}
			/>
		</div>
		{
			!print && (
				<div class="player-ui">
					<div
						class="progress"
						role="progressbar"
						aria-valuemin="1"
						aria-valuemax={deck.slides.length}
						aria-valuenow="1"
					>
						<i></i>
					</div>
					<p class="counter" aria-live="polite">
						<span data-current>1</span><span data-click-label hidden
							>.<span data-click-current>0</span></span
						>
						 / {deck.slides.length}
					</p>
					<a class="pdf-link" href={pdfHref}>
						PDF
					</a>
				</div>
			)
		}
		{
			!print && (
				<aside class="presenter" hidden data-presenter>
					<header class="presenter-head">
						<p class="presenter-head-label">発表者ビュー</p>
						<p class="presenter-clock" data-presenter-timer aria-live="polite">
							00:00
						</p>
					</header>
					<div class="presenter-grid">
						<section class="presenter-notes-block">
							<h2 class="presenter-label">ノート</h2>
							<div class="presenter-notes-scroll">
								<p class="presenter-notes" data-presenter-notes></p>
							</div>
						</section>
						<section class="presenter-next-block">
							<h2 class="presenter-label">次</h2>
							<p class="presenter-next-title" data-presenter-next-title></p>
							<p class="presenter-next-hint" data-presenter-next-hint hidden></p>
							<p class="presenter-next-empty" data-presenter-next-empty hidden>
								最後のスライド
							</p>
						</section>
					</div>
				</aside>
			)
		}
		{
			!print && (
				<dialog class="player-help" data-help>
					<h2>操作</h2>
					<dl>
						<dt>→ Space</dt>
						<dd>次のクリック、なければ次の枚</dd>
						<dt>←</dt>
						<dd>前のクリック、なければ前の枚</dd>
						<dt>Home / End</dt>
						<dd>最初 / 最後</dd>
						<dt>f</dt>
						<dd>フルスクリーン</dd>
						<dt>o</dt>
						<dd>概要グリッド</dd>
						<dt>p</dt>
						<dd>発表者ノート</dd>
						<dt>?</dt>
						<dd>この一覧</dd>
					</dl>
				</dialog>
			)
		}
		{
			!print && (
				<script>
					import "../slides/player/player.js";
				</script>
			)
		}
	</body>
</html>
