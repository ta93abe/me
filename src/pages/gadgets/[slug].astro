---
import GadgetThumb from "@/components/gadgets/GadgetThumb.astro";
import GadgetsViewTransitions from "@/components/gadgets/GadgetsViewTransitions.astro";
import { SITE } from "@/config/site";
import { GADGETS, getGadget } from "@/data/gadgets";
import Layout from "@/layouts/Layout.astro";

export function getStaticPaths() {
	return GADGETS.map((gadget) => ({
		params: { slug: gadget.slug },
	}));
}

const slug = Astro.params.slug;
if (!slug) {
	throw new Error("Missing gadget slug");
}

const gadget = getGadget(slug);
if (!gadget) {
	throw new Error(`Unknown gadget: ${slug}`);
}
---

<Layout
	title={`${gadget.name} | Gadgets | ${SITE.name}`}
	description={gadget.note}
>
	<GadgetsViewTransitions />
	<main class="mx-auto max-w-5xl px-6 py-12">
		<div
			class="grid grid-cols-1 md:grid-cols-[auto_minmax(0,42rem)] md:gap-x-8 lg:gap-x-12"
		>
			<a
				href="/gadgets"
				data-astro-prefetch
				class="mb-8 inline-flex w-fit items-baseline gap-2 text-sm text-(--text-muted) no-underline transition-colors hover:text-(--text-primary) focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--primary-color) md:sticky md:top-[calc(var(--header-height)+1.25rem)] md:mb-0 md:self-start"
			>
				<span aria-hidden="true" class="relative -top-px leading-none">↖</span>
				Gadgets
			</a>
			<article class="min-w-0 pb-8">
				<header class="text-center">
					<h1
						class="text-balance font-display text-2xl font-bold leading-tight text-(--text-primary) sm:text-3xl"
					>
						{gadget.name}
					</h1>
					<div
						class="mx-auto mt-10 grid h-60 max-w-xs place-items-center sm:h-64"
					>
						<GadgetThumb gadget={gadget} size="detail" />
					</div>
					{
						gadget.imageSource ? (
							<p class="mt-5 text-xs text-(--text-muted)">
								<a
									href={gadget.imageSource.href}
									target="_blank"
									rel="noopener noreferrer"
									aria-label={`${gadget.name} の画像出典`}
									class="underline decoration-(--border-color) underline-offset-4 transition-colors hover:text-(--text-primary)"
								>
									{gadget.imageSource.label ?? "Image source"}
								</a>
							</p>
						) : null
					}
				</header>
				<div class="prose mx-auto mt-12 max-w-xl">
					<p>{gadget.note}</p>
				</div>
			</article>
		</div>
	</main>
</Layout>
