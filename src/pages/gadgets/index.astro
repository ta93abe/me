---
import GadgetThumb from "@/components/gadgets/GadgetThumb.astro";
import GadgetsViewTransitions from "@/components/gadgets/GadgetsViewTransitions.astro";
import { SITE } from "@/config/site";
import { GADGETS, gadgetPath } from "@/data/gadgets";
import Layout from "@/layouts/Layout.astro";
import { stringifySchema } from "@/utils/schema";

const description =
	"毎日触っている物。ソフトウェアは Tools に置き、ここでは物だけを置く。";

const itemListSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: `Gadgets | ${SITE.name}`,
	description,
	itemListElement: GADGETS.map((gadget, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: gadget.name,
		url: new URL(gadgetPath(gadget.slug), Astro.site).href,
	})),
};
---

<Layout title={`Gadgets | ${SITE.name}`} description={description}>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(itemListSchema)}
		/>
	</Fragment>
	<GadgetsViewTransitions />
	<main class="mx-auto max-w-3xl px-6 py-12">
		<header class="mb-12">
			<h1 class="mb-4 font-display text-4xl font-bold text-(--text-primary)">
				Gadgets
			</h1>
			<p class="text-lg text-(--text-secondary)">
				ソフトウェアは
				<a href="/tools" class="text-(--primary-color) hover:underline">Tools</a>
				に置いています。ここでは毎日触っているものと、そうしている理由だけを置きます。
			</p>
		</header>

		<div
			class="grid w-full grid-cols-2 gap-x-5 gap-y-10 pb-10 sm:grid-cols-3 lg:grid-cols-4"
		>
			{
				GADGETS.map((gadget) => (
					<article class="min-w-0">
						<a
							href={gadgetPath(gadget.slug)}
							data-astro-prefetch
							aria-label={gadget.name}
							class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary-color)"
						>
							<div class="grid h-24 place-items-center transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:opacity-80 group-focus-visible:scale-[1.04] lg:h-28">
								<GadgetThumb gadget={gadget} size="grid" />
							</div>
							<div class="mt-3">
								<h2 class="truncate text-center text-sm text-(--text-primary)">
									{gadget.name}
								</h2>
							</div>
						</a>
					</article>
				))
			}
		</div>
	</main>
</Layout>
