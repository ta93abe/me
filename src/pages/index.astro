---
import HeroSection from "@/components/landing/HeroSection.astro";
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { generatePersonSchema, stringifySchema } from "@/utils/schema";

const personSchema = generatePersonSchema(Astro.site?.href || SITE.url);
---

<Layout
	title={`${SITE.name} (ta93abe) | Software Engineer`}
	description={SITE.description}
	ogImageAlt={SITE.tagline}
	flushTop
	lockViewport
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(personSchema)}
		/>
	</Fragment>
	<main class="home-main">
		<HeroSection />
	</main>
</Layout>

<style>
	.home-main {
		display: flex;
		flex-direction: column;
		min-height: 100%;
	}

	.home-main :global(.hero) {
		flex: 1 0 auto;
		min-height: 100%;
	}
</style>
