---
import HomeCta from "@/components/landing/HomeCta.astro";
import HomeHero from "@/components/landing/HomeHero.astro";
import HomeManifesto from "@/components/landing/HomeManifesto.astro";
import HomeStage from "@/components/landing/HomeStage.astro";
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { generatePersonSchema, stringifySchema } from "@/utils/schema";

const personSchema = generatePersonSchema(Astro.site?.href || SITE.url);
---

<Layout
	title={`${SITE.name} (ta93abe) | Software Engineer`}
	description={SITE.description}
	ogImageAlt={SITE.tagline}
	flushTop
	homeTheme
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(personSchema)}
		/>
	</Fragment>
	<main class="home-scroll">
		<HomeHero />
		<HomeStage />
		<HomeManifesto />
		<HomeCta />
	</main>
</Layout>

<style>
	.home-scroll {
		display: flex;
		flex-direction: column;
	}
</style>
