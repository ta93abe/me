---
import TalkCard from "@/components/TalkCard.astro";
import { SITE } from "@/config/site";
import {
	TALKS,
	TALK_THUMBNAIL_SIZES,
	talkThumbnailSrcset,
	talkThumbnailUrl,
} from "@/data/talks";
import Layout from "@/layouts/Layout.astro";
import { ogSectionPath } from "@/utils/og/sections";
import {
	generateBreadcrumbSchema,
	generateTalksCollectionSchema,
	stringifySchema,
	TALKS_COLLECTION_DESCRIPTION,
} from "@/utils/schema";

const site = Astro.site?.href || SITE.url;
const collectionSchema = generateTalksCollectionSchema(site);
const breadcrumbSchema = generateBreadcrumbSchema(site, [
	{ name: "Talks", path: "/talks/" },
]);
const lcpTalk = TALKS[0];
---

<Layout
	title={`Talks | ${SITE.name}`}
	description={TALKS_COLLECTION_DESCRIPTION}
	ogImage={ogSectionPath("talks")}
	ogImageAlt="Talks"
>
	<Fragment slot="head">
		{
			lcpTalk ? (
				<link
					rel="preload"
					as="image"
					href={talkThumbnailUrl(lcpTalk)}
					imagesrcset={talkThumbnailSrcset(lcpTalk)}
					imagesizes={TALK_THUMBNAIL_SIZES}
					fetchpriority="high"
					referrerpolicy="no-referrer"
				/>
			) : null
		}
		<script
			type="application/ld+json"
			set:html={stringifySchema(collectionSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={stringifySchema(breadcrumbSchema)}
		/>
	</Fragment>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<h1 class="mb-3 font-display text-3xl font-bold text-(--text-primary)">
				Talks
			</h1>
			<p class="text-(--text-secondary)">
				{TALKS_COLLECTION_DESCRIPTION}
			</p>
		</header>

		<div class="talks-cards">
			{TALKS.map((talk, index) => (
				<TalkCard talk={talk} priority={index === 0} />
			))}
		</div>
	</main>
</Layout>
