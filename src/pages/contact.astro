---
import SnsLinks from "@/components/SnsLinks.astro";
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { ogSectionPath } from "@/utils/og/sections";
import {
	CONTACT_DESCRIPTION,
	generateBreadcrumbSchema,
	generateContactPageSchema,
	stringifySchema,
} from "@/utils/schema";

const site = Astro.site?.href || SITE.url;
const contactSchema = generateContactPageSchema(site);
const breadcrumbSchema = generateBreadcrumbSchema(site, [
	{ name: "Contact", path: "/contact/" },
]);
---

<Layout
	title={`Contact | ${SITE.name}`}
	description={CONTACT_DESCRIPTION}
	ogImage={ogSectionPath("contact")}
	ogImageAlt="Contact"
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(contactSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={stringifySchema(breadcrumbSchema)}
		/>
	</Fragment>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<h1 class="mb-3 font-display text-3xl font-bold text-(--text-primary)">
				Contact
			</h1>
			<p class="text-(--text-secondary)">
				連絡は SNS からどうぞ。いちばん反応しやすいのは X（@ta93abe_）です。
			</p>
		</header>

		<section class="contact-sns" aria-labelledby="contact-sns-heading">
			<h2
				id="contact-sns-heading"
				class="mb-6 font-display text-xl font-bold text-(--text-primary)"
			>
				SNS
			</h2>
			<SnsLinks />
		</section>
	</main>
</Layout>
