---
import SnsLinks from "@/components/SnsLinks.astro";
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
---

<Layout
	title={`Links | ${SITE.name}`}
	description="いま更新している場所。GitHub、Zenn、X、LinkedIn、Speaker Deck、connpass、Substack。"
>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<h1 class="mb-3 font-display text-3xl font-bold text-(--text-primary)">
				Links
			</h1>
			<p class="text-(--text-secondary)">
				いま主に使っている場所です。コードは GitHub、記事は Zenn、日々の発信は
				X、ニュースレターは Substack。
			</p>
		</header>

		<SnsLinks />

		<section class="mt-16 pt-6 text-center">
			<p class="mb-4 text-sm text-(--text-secondary)">
				いちばん更新しているのは X（@ta93abe_）です。
			</p>
			<a
				href="https://x.com/ta93abe_"
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-2 bg-(--bg-secondary) px-5 py-2.5 text-sm text-(--text-primary) transition-colors hover:bg-(--bg-tertiary)"
			>
				<svg
					viewBox="0 0 24 24"
					class="h-4 w-4"
					fill="currentColor"
					aria-hidden="true"
				>
					<path
						d="M18.901 1.153h3.68l-8.04 9.19L24 22.846h-7.406l-5.8-7.584-6.638 7.584H.474l8.6-9.83L0 1.154h7.594l5.243 6.932ZM17.61 20.644h2.039L6.486 3.24H4.298Z"
					></path>
				</svg>
				X でフォローする
			</a>
		</section>
	</main>
</Layout>
