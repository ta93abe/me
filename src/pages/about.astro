---
import Button from "@/components/ui/Button.astro";
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
---

<Layout
	title={`About | ${SITE.name}`}
	description="ソフトウェアエンジニア Takumi Abe (ta93abe)。データ基盤と CI を書く。絵と音楽も置く。"
>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<p class="mb-2 text-sm tracking-wide text-(--text-muted)">ta93abe</p>
			<h1 class="font-display text-4xl font-bold tracking-tight text-(--text-primary)">
				{SITE.author}
			</h1>
			<p class="mt-2 font-sans text-sm font-medium text-(--text-secondary)">
				Software Engineer
			</p>
			<p class="mt-4 max-w-xl text-lg leading-relaxed text-(--text-secondary)">
				データ基盤と CI を書くソフトウェアエンジニア。絵と音楽も置く。
			</p>
		</header>

		<section class="mb-10" aria-labelledby="about-bio-heading">
			<h2 id="about-bio-heading" class="mb-3 text-lg font-bold text-(--text-primary)">
				自己紹介
			</h2>
			<p class="mb-3 leading-relaxed text-(--text-secondary)">
				ソフトウェアエンジニアとして、データ基盤と CI/CD を書いています。パイプラインが壊れにくいこと、差分だけを回せることを大切にしています。
			</p>
			<p class="leading-relaxed text-(--text-secondary)">
				仕事の外では絵・写真・音楽も置いています。完成したものは
				<a href="/gallery" class="text-(--link-color) underline underline-offset-2 hover:text-(--link-hover-color)">Gallery</a>、途中経過は
				<a href="/atelier" class="text-(--link-color) underline underline-offset-2 hover:text-(--link-hover-color)">Atelier</a>
				にあります。
			</p>
		</section>

		<section class="mb-10" aria-labelledby="about-sns-heading">
			<h2 id="about-sns-heading" class="mb-3 text-lg font-bold text-(--text-primary)">
				SNS
			</h2>
			<ul class="flex flex-wrap gap-x-5 gap-y-2">
				<li>
					<a
						href="https://github.com/ta93abe"
						target="_blank"
						rel="noopener noreferrer"
						class="text-(--link-color) underline underline-offset-2 hover:text-(--link-hover-color)"
					>
						GitHub
					</a>
				</li>
				<li>
					<a
						href="https://x.com/ta93abe_"
						target="_blank"
						rel="noopener noreferrer"
						class="text-(--link-color) underline underline-offset-2 hover:text-(--link-hover-color)"
					>
						X
					</a>
				</li>
				<li>
					<a
						href="https://linkedin.com/in/ta93abe"
						target="_blank"
						rel="noopener noreferrer"
						class="text-(--link-color) underline underline-offset-2 hover:text-(--link-hover-color)"
					>
						LinkedIn
					</a>
				</li>
			</ul>
		</section>

		<section aria-labelledby="about-contact-heading">
			<h2 id="about-contact-heading" class="mb-3 text-lg font-bold text-(--text-primary)">
				連絡
			</h2>
			<p class="mb-4 leading-relaxed text-(--text-secondary)">
				仕事の相談や連絡は Contact からどうぞ。
			</p>
			<Button href="/contact" variant="primary" size="md">
				Contact へ
			</Button>
		</section>
	</main>
</Layout>
