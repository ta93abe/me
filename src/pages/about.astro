---
import FeaturedWorksList from "@/components/FeaturedWorksList.astro";
import SnsLinks from "@/components/SnsLinks.astro";
import Button from "@/components/ui/Button.astro";
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { generatePersonSchema, stringifySchema } from "@/utils/schema";

const personSchema = generatePersonSchema(Astro.site?.href || SITE.url);
---

<Layout
	title={`About | ${SITE.name}`}
	description={SITE.description}
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(personSchema)}
		/>
	</Fragment>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<h1 class="mb-3 font-display text-3xl font-bold text-(--text-primary)">
				About
			</h1>
			<p
				class="mb-2 font-sans text-sm font-medium tracking-wide text-(--text-muted)"
			>
				{SITE.handle}
			</p>
			<p class="mb-4 font-display text-2xl font-bold text-(--text-primary)">
				{SITE.name}
			</p>
			<p class="max-w-xl text-(--text-secondary)">
				{SITE.tagline}
			</p>
		</header>

		<section class="mb-14" aria-labelledby="about-works-heading">
			<div class="mb-4 flex items-baseline justify-between gap-4">
				<h2
					id="about-works-heading"
					class="font-display text-xl font-bold text-(--text-primary)"
				>
					代表作
				</h2>
				<a
					href="/works"
					class="text-sm text-(--text-muted) no-underline hover:text-(--text-primary)"
				>
					Works
				</a>
			</div>
			<FeaturedWorksList source="about" />
		</section>

		<section class="mb-14" aria-labelledby="about-sns-heading">
			<h2
				id="about-sns-heading"
				class="mb-4 font-display text-xl font-bold text-(--text-primary)"
			>
				SNS
			</h2>
			<SnsLinks />
		</section>

		<p class="text-(--text-secondary)">連絡は Contact からどうぞ。</p>
		<div class="mt-4">
			<Button href="/contact" variant="primary">Contact</Button>
		</div>
	</main>
</Layout>
