---
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { getPageCopy, getToolCategories } from "@/lib/content/site-collections";
import { ogSectionPath } from "@/utils/og/sections";
import {
	generateBreadcrumbSchema,
	generateToolsCollectionSchema,
	stringifySchema,
	TOOLS_COLLECTION_DESCRIPTION,
} from "@/utils/schema";

const toId = (value: string) =>
	value
		.toLowerCase()
		.trim()
		.replace(/[\s_\\/]+/g, "-")
		.replace(/[^a-z0-9-]/g, "");

const categories = await getToolCategories();
const copy = await getPageCopy("tools");

const site = Astro.site?.href || SITE.url;
const collectionSchema = generateToolsCollectionSchema(
	site,
	categories.flatMap((category) => category.tools),
);
const breadcrumbSchema = generateBreadcrumbSchema(site, [
	{ name: "Tools", path: "/tools/" },
]);
---

<Layout
	title={`Tools | ${SITE.name}`}
	description={TOOLS_COLLECTION_DESCRIPTION}
	ogImage={ogSectionPath("tools")}
	ogImageAlt="Tools"
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(collectionSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={stringifySchema(breadcrumbSchema)}
		/>
	</Fragment>
	<main class="mx-auto max-w-3xl px-6 py-12">
		<header class="mb-12">
			<h1 class="mb-4 font-display text-4xl font-bold text-(--text-primary)">
				Tools
			</h1>
			{
				copy.lead ? (
					<p class="mb-4 text-lg text-(--text-secondary)">{copy.lead}</p>
				) : null
			}
			{
				copy.cta ? (
					<a
						href={copy.cta.href}
						target="_blank"
						rel="noopener noreferrer"
						class="inline-text-link inline-flex items-center gap-2 text-sm font-medium"
					>
						{copy.cta.label}
					</a>
				) : null
			}
		</header>

		{
			copy.points?.length ? (
				<section id="why-nix" class="mb-14">
					<h2 class="mb-4 text-lg font-bold text-(--text-primary)">
						{copy.pointsTitle}
					</h2>
					<ul class="space-y-3 text-(--text-secondary)">
						{copy.points.map((point) => (
							<li>
								<strong class="text-(--text-primary)">{point.label}</strong>
								{point.text}
							</li>
						))}
					</ul>
				</section>
			) : null
		}

		<div class="space-y-12">
			{
				categories.map((category) => (
					<section id={category.id}>
						<h2 class="mb-4 text-lg font-bold text-(--text-primary)">
							{category.title}
							<span class="ml-2 text-sm font-normal text-(--text-muted)">
								({category.tools.length})
							</span>
						</h2>

						<div class="space-y-4">
							{category.tools.map((tool) => {
								const toolId = `${category.id}-${toId(tool.name)}`;
								return (
									<article id={toolId}>
										<a
											href={tool.url}
											target="_blank"
											rel="noopener noreferrer"
											class="block py-4 transition-colors hover:text-(--primary-color)"
										>
											<h3 class="mb-1 font-mono text-base font-semibold text-(--text-primary)">
												{tool.name}
											</h3>
											<p class="text-sm text-(--text-secondary)">
												{tool.description}
											</p>
										</a>
									</article>
								);
							})}
						</div>
					</section>
				))
			}
		</div>
	</main>
</Layout>
