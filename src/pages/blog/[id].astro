---
import { render } from "astro:content";

import BlogEmbed from "@/components/blog/BlogEmbed.astro";
import PostNavigation from "@/components/PostNavigation.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import BackToTop from "@/components/ui/BackToTop.astro";
import Tag from "@/components/ui/Tag.astro";
import { SITE } from "@/config/site";
import { blogNeighbors } from "@/lib/content/blog";
import {
	blogEntryToListItem,
	getBlogEntries,
	type BlogEntry,
} from "@/lib/content/blog-collection";
import { BLOG_EMBED_COMPONENT } from "@/lib/content/remark-blog-embeds";
import Layout from "@/layouts/Layout.astro";
import { formatBlogSurfaceDate, toDatetimeAttr } from "@/utils/date";
import { formatReadingTime, getReadingTime } from "@/utils/reading-time";
import {
	generateArticleItemListSchema,
	generateBlogPostingSchema,
	generateBreadcrumbSchema,
	stringifySchema,
} from "@/utils/schema";

export async function getStaticPaths() {
	const entries = await getBlogEntries();
	const allPosts = entries.map(blogEntryToListItem);
	return entries.map((entry) => ({
		params: { id: entry.id },
		props: { entry, allPosts },
	}));
}

type Props = {
	entry: BlogEntry;
	allPosts: ReturnType<typeof blogEntryToListItem>[];
};

const { entry, allPosts } = Astro.props;
const post = blogEntryToListItem(entry);
const slug = post.slug;
const { Content } = await render(entry);
const components = { [BLOG_EMBED_COMPONENT]: BlogEmbed };

const neighbors = blogNeighbors(allPosts, slug);
const { title, excerpt, publish_date, revise_date, tags } = post;
const body = entry.body ?? "";

const readingTime = getReadingTime(body);
const readingTimeText = formatReadingTime(readingTime);
const publishedTime = toDatetimeAttr(publish_date);
const modifiedTime = revise_date ? toDatetimeAttr(revise_date) : publishedTime;
const ogImageURL = new URL(`/og/blog/${slug}.png`, Astro.site);
const site = Astro.site?.href || SITE.url;
const blogSchema = generateBlogPostingSchema(site, {
	slug,
	title,
	excerpt,
	date: publish_date,
	updatedDate: revise_date,
	tags,
	image: ogImageURL.href,
	body,
});
const breadcrumbSchema = generateBreadcrumbSchema(site, [
	{ name: "Blog", path: "/blog/" },
	{ name: title || "Blog", path: `/blog/${slug}/` },
]);
const itemListSchema = generateArticleItemListSchema(body);
---

<Layout
  title={`${title} | Blog | ${SITE.name}`}
  description={excerpt}
  ogType="article"
  ogImage={ogImageURL.href}
  ogImageAlt={title}
  canonicalURL={`/blog/${slug}/`}
>
  <Fragment slot="head">
    <meta property="article:author" content={SITE.author} />
    <meta property="article:published_time" content={publishedTime} />
    <meta property="article:modified_time" content={modifiedTime} />
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script
      type="application/ld+json"
      set:html={stringifySchema(blogSchema)}
    />
    <script
      type="application/ld+json"
      set:html={stringifySchema(breadcrumbSchema)}
    />
    {
      itemListSchema && (
        <script
          type="application/ld+json"
          set:html={stringifySchema(itemListSchema)}
        />
      )
    }
  </Fragment>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <a
      href="/blog/"
      class="mb-6 inline-block text-sm tracking-wide text-(--text-muted) hover:text-(--text-primary)"
    >
      ← 一覧へ戻る
    </a>

    <header class="mb-12 pb-10">
      <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-(--text-muted)">
        <time class="font-medium" datetime={publishedTime}>
          {formatBlogSurfaceDate(publish_date, revise_date)}
        </time>
        <span class="text-(--text-muted)">·</span>
        <span>{readingTimeText}</span>
      </div>

      <h1 class="font-display mb-6 text-3xl font-bold leading-tight tracking-tight text-(--text-primary) sm:text-4xl">
        {title}
      </h1>

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <Tag>{tag}</Tag>
            ))}
          </div>
        )
      }
    </header>

    <article class="prose prose-lg">
      <Content components={components} />
    </article>

    {neighbors && <PostNavigation prevPost={neighbors.prev} nextPost={neighbors.next} />}

    {neighbors && <RelatedPosts posts={neighbors.related} />}
  </main>
  <BackToTop />
</Layout>

<script>
  document.querySelectorAll(".youtube-embed-lazy").forEach((button) => {
    button.addEventListener("click", () => {
      const figure = button.closest(".youtube-embed");
      if (!(figure instanceof HTMLElement)) {
        return;
      }
      const id = figure.dataset.youtubeId;
      if (!id) {
        return;
      }
      const start = figure.dataset.youtubeStart;
      const params = new URLSearchParams({
        autoplay: "1",
        rel: "0",
        modestbranding: "1",
        playsinline: "1",
      });
      if (start && /^\d+$/.test(start) && Number(start) > 0) {
        params.set("start", start);
      }
      const src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?${params}`;
      const iframe = document.createElement("iframe");
      iframe.className = "youtube-embed-frame";
      iframe.src = src;
      iframe.title = button.getAttribute("aria-label") ?? "YouTube video";
      iframe.loading = "lazy";
      iframe.referrerPolicy = "no-referrer";
      iframe.allow =
        "accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share";
      iframe.allowFullscreen = true;
      figure.replaceChildren(iframe);
    });
  });
</script>

<script>
  import { enhanceCodeCopyButtons } from "@/scripts/blog-copy-button.ts";

  enhanceCodeCopyButtons();
</script>

<script>
  window.posthog?.capture("blog_post_viewed", {
    post_title: document.title,
    post_url: window.location.href,
  });
</script>
