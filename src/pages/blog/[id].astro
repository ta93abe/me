---
export const prerender = false;

import type { CollectionEntry } from "astro:content";
import { getCollection, getEntry, render } from "astro:content";
import NewsletterCta from "@/components/NewsletterCta.astro";
import PostNavigation from "@/components/PostNavigation.astro";
import RelatedPosts from "@/components/RelatedPosts.astro";
import BackToTop from "@/components/ui/BackToTop.astro";
import Tag from "@/components/ui/Tag.astro";
import { SITE } from "@/config/site";
import { getContentBucket } from "@/lib/content/bindings";
import {
	blogNeighbors,
	listBlogPosts,
	loadBlogPost,
	mergeBlogLists,
	type BlogListItem,
	type BlogPost,
} from "@/lib/content/blog";
import { BLOG_HTML_CACHE_CONTROL } from "@/lib/content/cache";
import Layout from "@/layouts/Layout.astro";
import { formatDate } from "@/utils/date";
import { formatReadingTime, getReadingTime } from "@/utils/reading-time";
import { stringifySchema } from "@/utils/schema";

function fromCollection(post: CollectionEntry<"blog">): BlogListItem {
	return {
		slug: post.id,
		title: post.data.title,
		excerpt: post.data.excerpt,
		date: post.data.date,
		updatedDate: post.data.updatedDate,
		tags: post.data.tags ?? [],
	};
}

const slug = Astro.params.id ?? "";
const bucket = await getContentBucket();
const r2Post = bucket ? await loadBlogPost(bucket, slug) : null;
const leftoverEntries = await getCollection("blog");
const leftover = leftoverEntries.map(fromCollection);
const r2List = bucket ? await listBlogPosts(bucket) : [];
const allPosts = mergeBlogLists(r2List, leftover);

let post: BlogPost | CollectionEntry<"blog"> | null = r2Post;
let MdxContent: Awaited<ReturnType<typeof render>>["Content"] | undefined;
let source: "r2" | "mdx" | "missing" = r2Post ? "r2" : "missing";

if (!r2Post) {
	const entry = await getEntry("blog", slug);
	if (entry) {
		source = "mdx";
		post = entry;
		const rendered = await render(entry);
		MdxContent = rendered.Content;
	}
}

if (!post || source === "missing") {
	return Astro.rewrite("/404");
}

const neighbors = blogNeighbors(allPosts, slug);
const title = source === "r2" ? (post as BlogPost).title : (post as CollectionEntry<"blog">).data.title;
const excerpt = source === "r2" ? (post as BlogPost).excerpt : (post as CollectionEntry<"blog">).data.excerpt;
const date = source === "r2" ? (post as BlogPost).date : (post as CollectionEntry<"blog">).data.date;
const updatedDate = source === "r2" ? (post as BlogPost).updatedDate : (post as CollectionEntry<"blog">).data.updatedDate;
const tags = source === "r2" ? (post as BlogPost).tags : ((post as CollectionEntry<"blog">).data.tags ?? []);
const body = source === "r2" ? (post as BlogPost).body : ((post as CollectionEntry<"blog">).body ?? "");
const html = source === "r2" ? (post as BlogPost).html : "";

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const readingTime = getReadingTime(body);
const readingTimeText = formatReadingTime(readingTime);
const publishedTime = date.toISOString();
const modifiedTime = updatedDate ? updatedDate.toISOString() : publishedTime;
const ogImageURL = new URL(
	source === "mdx" ? `/og/blog/${slug}.png` : "/og/default.png",
	Astro.site,
);
const blogSchema = {
	"@context": "https://schema.org",
	"@type": "BlogPosting",
	headline: title,
	description: excerpt,
	datePublished: publishedTime,
	dateModified: modifiedTime,
	author: {
		"@type": "Person",
		name: SITE.author,
		url: Astro.site?.href,
	},
	image: ogImageURL.href,
	mainEntityOfPage: canonicalURL.href,
	inLanguage: SITE.lang,
	...(tags.length > 0 ? { keywords: tags.join(", ") } : {}),
};

Astro.response.headers.set("Cache-Control", BLOG_HTML_CACHE_CONTROL);
---

<Layout
  title={`${title} | Blog | ${SITE.name}`}
  description={excerpt}
  ogType="article"
  ogImage={ogImageURL.href}
  ogImageAlt={title}
>
  <Fragment slot="head">
    <meta property="article:author" content={SITE.author} />
    <meta property="article:published_time" content={publishedTime} />
    {
      updatedDate && (
        <meta property="article:modified_time" content={modifiedTime} />
      )
    }
    {tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <script
      type="application/ld+json"
      set:html={stringifySchema(blogSchema)}
    />
  </Fragment>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <a
      href="/blog"
      class="mb-6 inline-block text-sm tracking-wide text-(--text-muted) hover:text-(--text-primary)"
    >
      ← 一覧へ戻る
    </a>

    <header class="mb-12 pb-10">
      <div class="mb-4 flex flex-wrap items-center gap-3 text-sm text-(--text-muted)">
        <time class="font-medium">
          {formatDate(date)}
        </time>
        {
          updatedDate && (
            <>
              <span class="text-(--text-muted)">|</span>
              <span>更新: {formatDate(updatedDate)}</span>
            </>
          )
        }
        <span class="text-(--text-muted)">|</span>
        <span>{readingTimeText}</span>
      </div>

      <h1 class="font-display mb-6 text-3xl font-bold leading-tight tracking-tight text-(--text-primary) sm:text-4xl">
        {title}
      </h1>

      {
        tags.length > 0 && (
          <div class="flex flex-wrap gap-2">
            {tags.map((tag: string) => (
              <Tag>{tag}</Tag>
            ))}
          </div>
        )
      }
    </header>

    <article class="prose prose-lg">
      {source === "r2" ? <Fragment set:html={html} /> : MdxContent && <MdxContent />}
    </article>

    <NewsletterCta source="blog-post" />

    <PostNavigation prevPost={neighbors.prev} nextPost={neighbors.next} />

    <RelatedPosts posts={neighbors.related} />
  </main>
  <BackToTop />
</Layout>

<script>
  declare global {
    interface Window {
      posthog?: { capture: (event: string, properties?: Record<string, unknown>) => void };
    }
  }

  const copyIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path d="M7 3.5A1.5 1.5 0 0 1 8.5 2h3.879a1.5 1.5 0 0 1 1.06.44l3.122 3.12A1.5 1.5 0 0 1 17 6.622V12.5a1.5 1.5 0 0 1-1.5 1.5h-1v-3.379a3 3 0 0 0-.879-2.121L10.5 5.379A3 3 0 0 0 8.379 4.5H7v-1Z" /><path d="M4.5 6A1.5 1.5 0 0 0 3 7.5v9A1.5 1.5 0 0 0 4.5 18h7a1.5 1.5 0 0 0 1.5-1.5v-5.879a1.5 1.5 0 0 0-.44-1.06L9.44 6.439A1.5 1.5 0 0 0 8.378 6H4.5Z" /></svg>`;
  const copiedIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor"><path fill-rule="evenodd" d="M16.704 4.153a.75.75 0 0 1 .143 1.052l-8 10.5a.75.75 0 0 1-1.127.075l-4.5-4.5a.75.75 0 0 1 1.06-1.06l3.894 3.893 7.48-9.817a.75.75 0 0 1 1.05-.143Z" clip-rule="evenodd" /></svg>`;

  document.querySelectorAll(".prose pre").forEach((pre) => {
    const button = document.createElement("button");
    button.className = "copy-button";
    button.innerHTML = copyIcon;
    button.addEventListener("click", async () => {
      const code = pre.querySelector("code");
      if (code) {
        await navigator.clipboard.writeText(code.textContent || "");
        button.classList.add("copied");
        button.innerHTML = copiedIcon;
        window.posthog?.capture("blog_code_copied", {
          post_title: document.title,
          post_url: window.location.href,
        });
        setTimeout(() => {
          button.classList.remove("copied");
          button.innerHTML = copyIcon;
        }, 2000);
      }
    });
    pre.appendChild(button);
  });
</script>

<script>
  window.posthog?.capture("blog_post_viewed", {
    post_title: document.title,
    post_url: window.location.href,
  });
</script>
