---
export const prerender = false;

import FilterSort from "@/components/FilterSort.astro";
import { SITE } from "@/config/site";
import { getContentBucket } from "@/lib/content/bindings";
import { listBlogPosts } from "@/lib/content/blog";
import { BLOG_HTML_CACHE_CONTROL } from "@/lib/content/cache";
import Layout from "@/layouts/Layout.astro";
import { ogSectionPath } from "@/utils/og/sections";
import {
	BLOG_COLLECTION_DESCRIPTION,
	generateBlogCollectionSchema,
	generateBreadcrumbSchema,
	stringifySchema,
} from "@/utils/schema";

const bucket = await getContentBucket();
const sortedPosts = bucket ? await listBlogPosts(bucket) : [];
const allTags = sortedPosts.flatMap((post) => post.tags);
const site = Astro.site?.href || SITE.url;
const collectionSchema = generateBlogCollectionSchema(
	site,
	sortedPosts.map((post) => ({
		slug: post.slug,
		title: post.title,
		excerpt: post.excerpt,
		date: post.publish_date,
	})),
);
const breadcrumbSchema = generateBreadcrumbSchema(site, [
	{ name: "Blog", path: "/blog/" },
]);

Astro.response.headers.set("Cache-Control", BLOG_HTML_CACHE_CONTROL);
---

<Layout
	title={`Blog | ${SITE.name}`}
	description={BLOG_COLLECTION_DESCRIPTION}
	ogImage={ogSectionPath("blog")}
	ogImageAlt="Blog"
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(collectionSchema)}
		/>
		<script
			type="application/ld+json"
			set:html={stringifySchema(breadcrumbSchema)}
		/>
	</Fragment>
  <main class="mx-auto max-w-3xl px-6 py-12">
    <header class="mb-10 flex items-baseline justify-between gap-4">
      <h1 class="font-display text-4xl font-bold tracking-tight text-(--text-primary)">Blog</h1>
      <a
        href="/rss.xml"
        id="rss-feed-link"
        class="shrink-0 text-(--text-muted) transition-opacity hover:opacity-60"
        aria-label="RSS フィード"
      >
        <svg
          class="size-4"
          fill="currentColor"
          viewBox="0 0 24 24"
          aria-hidden="true"
        >
          <path
            d="M6.503 20.752c0 1.794-1.456 3.248-3.251 3.248-1.796 0-3.252-1.454-3.252-3.248 0-1.794 1.456-3.248 3.252-3.248 1.795.001 3.251 1.454 3.251 3.248zm-6.503-12.572v4.811c6.05.062 10.96 4.966 11.022 11.009h4.817c-.062-8.71-7.118-15.758-15.839-15.82zm0-3.368c10.58.046 19.152 8.594 19.183 19.188h4.817c-.03-13.231-10.755-23.954-24-24v4.812z"
          ></path>
        </svg>
      </a>
    </header>

    <FilterSort
      tags={allTags}
      containerId="blog-list"
      hideResultCount
      hideTagLabel
    />

    {
      sortedPosts.length === 0 ? (
        <p role="status" class="text-(--text-secondary)">
          まだ記事を置いていません。
        </p>
      ) : (
        <div id="blog-list" class="flex flex-col">
          {sortedPosts.map((post) => (
            <article
              class="group border-b border-(--border-color) last:border-b-0"
              data-item
              data-tags={post.tags.join(",")}
            >
              <a
                href={`/blog/${post.slug}/`}
                class="block py-4 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-(--primary-color)"
              >
                <h2 class="font-display text-lg font-bold text-(--text-primary) transition-colors group-hover:text-(--primary-color) sm:text-xl">
                  {post.title}
                </h2>
              </a>
            </article>
          ))}
        </div>
      )
    }

  </main>
</Layout>

<script>
  document.getElementById("rss-feed-link")?.addEventListener("click", () => {
    window.posthog?.capture("rss_feed_clicked", { page: "blog" });
  });

  document.querySelectorAll("[data-filter-sort] .filter-chip").forEach((chip) => {
    chip.addEventListener("click", () => {
      const tag = (chip as HTMLElement).dataset.tag;
      if (tag && tag !== "all") {
        window.posthog?.capture("blog_tag_filtered", { tag });
      }
    });
  });
</script>
