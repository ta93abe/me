---
import ThingThumb from "@/components/things/ThingThumb.astro";
import ThingsViewTransitions from "@/components/things/ThingsViewTransitions.astro";
import { SITE } from "@/config/site";
import { THINGS, thingPath } from "@/data/things";
import Layout from "@/layouts/Layout.astro";
import { stringifySchema } from "@/utils/schema";

const description =
	"机の上にあるもの。ソフトウェアは Tools に置き、ここでは毎日触っている物だけを置く。";

const itemListSchema = {
	"@context": "https://schema.org",
	"@type": "ItemList",
	name: `Things | ${SITE.name}`,
	description,
	itemListElement: THINGS.map((thing, index) => ({
		"@type": "ListItem",
		position: index + 1,
		name: thing.name,
		url: new URL(thingPath(thing.slug), Astro.site).href,
	})),
};
---

<Layout title={`Things | ${SITE.name}`} description={description}>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(itemListSchema)}
		/>
	</Fragment>
	<ThingsViewTransitions />
	<main class="mx-auto max-w-3xl px-6 py-12">
		<header class="mb-12">
			<h1 class="mb-4 font-display text-4xl font-bold text-(--text-primary)">
				Things
			</h1>
			<p class="text-lg text-(--text-secondary)">
				ソフトウェアは
				<a href="/tools" class="text-(--primary-color) hover:underline">Tools</a>
				に置いています。ここでは机の上にあるものと、そうしている理由だけを置きます。
			</p>
		</header>

		<div
			class="grid w-full grid-cols-2 gap-x-5 gap-y-10 pb-10 sm:grid-cols-3 lg:grid-cols-4"
		>
			{
				THINGS.map((thing) => (
					<article class="min-w-0">
						<a
							href={thingPath(thing.slug)}
							data-astro-prefetch
							aria-label={thing.name}
							class="group block focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-(--primary-color)"
						>
							<div class="grid h-24 place-items-center transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:opacity-80 group-focus-visible:scale-[1.04] lg:h-28">
								<ThingThumb thing={thing} size="grid" />
							</div>
							<div class="mt-3">
								<h2 class="truncate text-center text-sm text-(--text-primary)">
									{thing.name}
								</h2>
							</div>
						</a>
					</article>
				))
			}
		</div>
	</main>
</Layout>
