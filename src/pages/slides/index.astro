---
import SlideDeckCard from "@/components/SlideDeckCard.astro";
import SlideDeckGroupSection from "@/components/SlideDeckGroupSection.astro";
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { partitionDecksForIndex } from "@/lib/slides/partition-decks";
import { listedDecks } from "@/lib/slides/visibility";
import { loadDecks } from "@/slides/load-decks";
import {
	generateSlidesCollectionSchema,
	SLIDES_COLLECTION_DESCRIPTION,
	stringifySchema,
} from "@/utils/schema";

const decks = listedDecks(await loadDecks());
const { groups, ungrouped } = partitionDecksForIndex(decks);
const collectionSchema = generateSlidesCollectionSchema(
	Astro.site?.href || SITE.url,
	decks.map((deck) => ({
		slug: deck.frontmatter.slug,
		title: deck.frontmatter.title,
		description: deck.frontmatter.description,
		date: deck.frontmatter.date,
	})),
);
---

<Layout
	title={`Slides | ${SITE.name}`}
	description={SLIDES_COLLECTION_DESCRIPTION}
	ogImage="/og/slides.png"
	ogImageAlt="Slides"
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(collectionSchema)}
		/>
	</Fragment>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<h1 class="mb-3 font-display text-3xl font-bold text-(--text-primary)">
				Slides
			</h1>
			<p class="text-(--text-secondary)">{SLIDES_COLLECTION_DESCRIPTION}</p>
		</header>

		{
			decks.length === 0 ? (
				<p class="text-(--text-secondary)" role="status">
					スライドがありません。
				</p>
			) : (
				<div class="slides-index">
					{groups.map((section) => (
						<SlideDeckGroupSection section={section} />
					))}
					{
						ungrouped.length > 0 ? (
							<div class="slide-deck-list">
								{ungrouped.map((deck) => (
									<SlideDeckCard frontmatter={deck.frontmatter} />
								))}
							</div>
						) : null
					}
				</div>
			)
		}
	</main>
</Layout>

<style>
	.slides-index {
		display: flex;
		flex-direction: column;
		gap: 0.5rem;
	}

	.slide-deck-list :global(.slide-deck-card:first-child) {
		border-top: 0;
		padding-top: 0;
	}
</style>
