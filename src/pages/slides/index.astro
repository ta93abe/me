---
import SlideDeckCard from "@/components/SlideDeckCard.astro";
import { SITE } from "@/config/site";
import Layout from "@/layouts/Layout.astro";
import { loadDecks } from "@/slides/load-decks";
import {
	generateSlidesCollectionSchema,
	SLIDES_COLLECTION_DESCRIPTION,
	stringifySchema,
} from "@/utils/schema";

const decks = await loadDecks();
const collectionSchema = generateSlidesCollectionSchema(
	Astro.site?.href || SITE.url,
	decks.map((deck) => ({
		slug: deck.frontmatter.slug,
		title: deck.frontmatter.title,
		description: deck.frontmatter.description,
		date: deck.frontmatter.date,
	})),
);
---

<Layout
	title={`Slides | ${SITE.name}`}
	description={SLIDES_COLLECTION_DESCRIPTION}
	ogImage="/og/slides.png"
	ogImageAlt="Slides"
>
	<Fragment slot="head">
		<script
			type="application/ld+json"
			set:html={stringifySchema(collectionSchema)}
		/>
	</Fragment>
	<main class="mx-auto max-w-3xl px-6 py-16">
		<header class="mb-12">
			<h1 class="mb-3 font-display text-3xl font-bold text-(--text-primary)">
				Slides
			</h1>
			<p class="text-(--text-secondary)">{SLIDES_COLLECTION_DESCRIPTION}</p>
		</header>

		{
			decks.length === 0 ? (
				<p class="text-(--text-secondary)" role="status">
					スライドがありません。
				</p>
			) : (
				<div class="slide-deck-list">
					{decks.map((deck) => (
						<SlideDeckCard frontmatter={deck.frontmatter} />
					))}
				</div>
			)
		}
	</main>
</Layout>
