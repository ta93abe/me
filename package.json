{
	"name": "me",
	"version": "0.0.1",
	"packageManager": "pnpm@12.4.2",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"dev:bg": "astro dev --background",
		"dev:json": "astro dev --json",
		"dev:status": "astro dev status",
		"dev:stop": "astro dev stop",
		"dev:logs": "astro dev logs",
		"dev:extra": "astro dev --ignore-lock",
		"build": "astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "oxlint --fix src worker tests scripts",
		"format": "oxfmt src worker tests scripts",
		"format:check": "oxfmt --check src worker tests scripts",
		"check": "astro check",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"deploy": "pnpm build && wrangler deploy",
		"infra:deploy": "alchemy deploy infra/alchemy.run.ts --stage prod",
		"infra:plan": "alchemy plan infra/alchemy.run.ts --stage prod",
		"perf:lighthouse": "node scripts/perf/lighthouse-audit.mjs",
		"perf:cwv": "node scripts/perf/collect-cwv.mjs",
		"agent-ready:scan": "node scripts/agent-ready/scan.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.10",
		"@astrojs/cloudflare": "^14.3.2",
		"@astrojs/react": "^6.0.6",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.4",
		"@cf-wasm/resvg": "^0.4.0",
		"@cf-wasm/satori": "^0.4.1",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/noto-serif-jp": "^5.3.0",
		"@fontsource/shippori-mincho": "^5.3.0",
		"@resvg/resvg-js": "^2.6.2",
		"@shikijs/rehype": "^4.4.3",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"astro": "^7.3.3",
		"framer-motion": "^13.4.0",
		"gsap": "^3.15.0",
		"katex": "^0.18.7",
		"lenis": "^1.3.26",
		"marked": "^18.0.13",
		"node-html-parser": "^9.0.4",
		"posthog-js": "^1.434.0",
		"prismjs": "^1.30.0",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"rehype-katex": "^7.0.1",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"satori": "^0.33.4",
		"sharp": "^0.35.4",
		"shiki": "^4.4.3",
		"simple-icons": "^16.31.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"three": "^0.186.0",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.1.0",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@effect/platform-node": "4.0.0-rc.115",
		"@playwright/test": "^1.63.0",
		"@types/hast": "^3.0.5",
		"@types/node": "^26.6.1",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"@vitest/ui": "^5.0.1",
		"alchemy": "2.0.0-beta.79",
		"chrome-launcher": "^1.2.1",
		"effect": "4.0.0-rc.115",
		"happy-dom": "^20.14.5",
		"lighthouse": "^13.4.1",
		"oxfmt": "^0.68.0",
		"oxlint": "^1.83.0",
		"puppeteer-core": "^25.11.0",
		"vite": "8.3.0",
		"vitest": "^5.0.1",
		"wrangler": "^4.134.0"
	}
}
