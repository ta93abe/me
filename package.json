{
	"name": "me",
	"version": "0.0.1",
	"packageManager": "pnpm@12.4.2",
	"type": "module",
	"scripts": {
		"dev": "astro dev",
		"dev:bg": "astro dev --background",
		"dev:json": "astro dev --json",
		"dev:status": "astro dev status",
		"dev:stop": "astro dev stop",
		"dev:logs": "astro dev logs",
		"dev:extra": "astro dev --ignore-lock",
		"build": "node scripts/unshallow-git.mjs && astro build",
		"preview": "astro preview",
		"astro": "astro",
		"lint": "oxlint --fix src worker tests scripts",
		"format": "oxfmt src worker tests scripts",
		"format:check": "oxfmt --check src worker tests scripts",
		"check": "astro check",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:e2e:smoke": "playwright test --project=chromium --grep @smoke",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:report": "playwright show-report",
		"deploy": "pnpm build && wrangler deploy",
		"infra:deploy": "alchemy deploy infra/alchemy.run.ts --stage prod",
		"infra:plan": "alchemy plan infra/alchemy.run.ts --stage prod",
		"perf:lighthouse": "node scripts/perf/lighthouse-audit.mjs",
		"perf:cwv": "node scripts/perf/collect-cwv.mjs",
		"agent-ready:scan": "node scripts/agent-ready/scan.mjs"
	},
	"dependencies": {
		"@astrojs/check": "^0.9.12",
		"@astrojs/cloudflare": "^14.4.8",
		"@astrojs/markdown-remark": "^7.3.9",
		"@astrojs/mdx": "^8.1.6",
		"@astrojs/react": "^7.1.9",
		"@astrojs/rss": "^4.0.19",
		"@astrojs/sitemap": "^3.7.5",
		"@cf-wasm/resvg": "^0.4.0",
		"@cf-wasm/satori": "^0.4.2",
		"@fontsource/inter": "^5.3.0",
		"@fontsource/noto-serif-jp": "^5.3.1",
		"@fontsource/shippori-mincho": "^5.3.0",
		"@paper-design/shaders": "0.0.82",
		"@resvg/resvg-js": "^2.6.2",
		"@shikijs/rehype": "^4.6.0",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.5",
		"astro": "^7.4.12",
		"gsap": "^3.15.1",
		"katex": "^0.19.1",
		"lenis": "^1.3.27",
		"marked": "^18.3.0",
		"node-html-parser": "^9.0.7",
		"posthog-js": "^1.450.0",
		"prismjs": "^1.30.0",
		"react": "^19.3.1",
		"react-dom": "^19.3.1",
		"rehype-katex": "^7.0.1",
		"rehype-stringify": "^10.0.1",
		"remark-gfm": "^4.0.1",
		"remark-math": "^6.0.0",
		"remark-parse": "^11.0.0",
		"remark-rehype": "^11.1.2",
		"satori": "^0.63.2",
		"sharp": "^0.35.5",
		"shiki": "^4.6.0",
		"simple-icons": "^16.38.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.5",
		"typescript": "^6.0.3",
		"unified": "^11.0.5",
		"unist-util-visit": "^5.2.0",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@effect/platform-node": "4.0.0-rc.115",
		"@playwright/test": "^1.65.1",
		"@types/hast": "^3.0.5",
		"@types/mdast": "^4.0.4",
		"@types/node": "^26.6.6",
		"@types/prismjs": "^1.26.6",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/unist": "^3.0.3",
		"@vitest/ui": "^5.1.0",
		"alchemy": "2.0.0-beta.79",
		"chrome-launcher": "^1.2.3",
		"effect": "4.0.0-rc.117",
		"happy-dom": "^21.0.4",
		"lighthouse": "^13.6.0",
		"oxfmt": "^0.79.0",
		"oxlint": "^1.94.0",
		"puppeteer-core": "^25.17.0",
		"remark-mdx": "^3.1.1",
		"subset-font": "^2.9.0",
		"vfile": "^6.0.3",
		"vite": "8.3.8",
		"vitest": "^5.1.0",
		"wrangler": "^4.163.0"
	}
}
